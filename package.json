{
  "name": "cluide",
  "version": "0.2.0",
  "description": "A tiny local web UI to view and edit your Claude Code setup",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "cluide": "bin/cluide.ts"
  },
  "files": [
    "bin",
    "server",
    "!server/tests",
    "shared",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulcer/cluide.git"
  },
  "homepage": "https://github.com/sulcer/cluide#readme",
  "bugs": {
    "url": "https://github.com/sulcer/cluide/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "start": "bun server/index.ts --open",
    "test": "bun test server shared src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "e2e": "bunx playwright test -c e2e/playwright.config.ts",
    "render": "bunx playwright test -c e2e/playwright.config.ts render.spec.ts",
    "gif": "GIF=1 bunx playwright test -c e2e/playwright.config.ts tour.spec.ts && rm -rf e2e/test-results/frames && mkdir -p e2e/test-results/frames && ffmpeg -y -loglevel error -ss 0.35 -i e2e/test-results/tour.webm -vf fps=12 e2e/test-results/frames/%04d.png && gifski -o docs/readme/tour.gif --fps 12 --quality 70 --motion-quality 92 --width 1536 e2e/test-results/frames/*.png && ls -lh docs/readme/tour.gif",
    "check-docs": "bun scripts/check-docs.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
